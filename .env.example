# Origen de datos: 'json' (data/invitations.json) o 'database' (PostgreSQL)
DATA_SOURCE="json"

# Base de datos
DATABASE_URL="postgresql://usuario:contraseña@host:5432/citas?schema=public"

# Render del PNG: ruta al binario de Chrome/Chromium si no está en una ruta habitual
# CHROMIUM_PATH="/usr/bin/chromium"

# Dominio público, para las vistas previas al compartir
# NEXT_PUBLIC_SITE_URL="https://…"

# Cobro. 'mock' solo en desarrollo; el código lo prohíbe en producción.
PAYMENTS_PROVIDER="mock"
# PAYMENTS_PROVIDER="whish"
# WHISH_BASE_URL="https://…"
# WHISH_CHANNEL=""
# WHISH_SECRET=""
# WHISH_WEBSITE_URL="https://…"
