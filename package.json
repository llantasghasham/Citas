{
  "name": "citas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @citas/web",
    "build": "npm run build --workspace @citas/web",
    "start": "npm run start --workspace @citas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:rtl": "npm run lint:rtl --workspace @citas/web",
    "lint:planes": "npm run lint:planes --workspace @citas/web",
    "db:migrate": "npm run db:migrate --workspace @citas/web",
    "db:deploy": "npm run db:deploy --workspace @citas/web",
    "db:fleet": "npm run db:fleet --workspace @citas/web --",
    "db:split": "npm run db:split --workspace @citas/web --",
    "db:check": "npm run db:check --workspace @citas/web",
    "db:seed": "npm run db:seed --workspace @citas/web",
    "db:studio": "npm run db:studio --workspace @citas/web",
    "mobile": "npm run start --workspace @citas/mobile",
    "whatsapp": "npm run start --workspace @citas/whatsapp"
  }
}
