{
  "expo": {
    "name": "Citas",
    "slug": "citas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.posxml.citas",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.posxml.citas",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "citas",
    "extra": {
      "supportsRTL": true
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "locales": {
      "ar": "./locales/store.ar.json",
      "es": "./locales/store.es.json",
      "pt": "./locales/store.pt.json",
      "en": "./locales/store.en.json"
    }
  }
}
