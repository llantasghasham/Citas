# Origen de datos: 'json' (data/invitations.json) o 'database' (PostgreSQL)
DATA_SOURCE="json"

# Base de datos
DATABASE_URL="postgresql://usuario:contraseña@host:5432/citas?schema=public"

# Render del PNG: ruta al binario de Chrome/Chromium si no está en una ruta habitual
# CHROMIUM_PATH="/usr/bin/chromium"

# Dominio público, para las vistas previas al compartir
# NEXT_PUBLIC_SITE_URL="https://…"

# Acceso. El seed crea este superadministrador; es el único que puede entrar
# hasta que exista el alta de clientes.
SUPERADMIN_EMAIL="admin@citas.local"

# Envío de correo. En desarrollo los códigos se imprimen en el log del servidor.
# En producción hay que configurar un proveedor real: el emisor de consola se
# niega a arrancar allí.

# Cobro. 'mock' solo en desarrollo; el código lo prohíbe en producción.
PAYMENTS_PROVIDER="mock"
# PAYMENTS_PROVIDER="whish"
# WHISH_BASE_URL="https://…"
# WHISH_CHANNEL=""
# WHISH_SECRET=""
# WHISH_WEBSITE_URL="https://…"

# Correo saliente. 'smtp' envía de verdad; cualquier otro valor imprime en el
# log y se niega a arrancar en producción.
# MAILER="smtp"
# SMTP_HOST="smtp.tu-proveedor.com"
# SMTP_PORT="587"
# SMTP_USER="info@tu-dominio.com"
#
# OJO: el remitente se llama MAIL_FROM, NO SMTP_FROM. Escribir SMTP_FROM es un
# error que ya costó un despliegue: el envío revienta al primer código.
# MAIL_FROM="Tu Marca <info@tu-dominio.com>"
#
# OJO: aquí va el valor CIFRADO, que empieza por "v1.". Pegar la contraseña en
# claro en esta línea es el otro error que ya costó un despliegue: parece
# configurado y solo falla cuando alguien intenta entrar. Se cifra con:
#   printf %s 'la-contraseña' | npm run secret:encrypt --workspace @citas/web
# y la llave vive fuera del proyecto:
# CITAS_SECRET_KEY_FILE="/etc/citas/secret.key"
# SMTP_PASSWORD_ENC="v1....."
#
# Las dos equivocaciones las caza /panel/sistema antes de que nadie intente
# entrar, y nombra la variable exacta que está mal.
