// Modelo de datos de la plataforma. Diseño de la fase 2 — todavía NO está en uso:
// la fase 1 lee las invitaciones de data/invitations.json. Instalar Prisma y
// levantar PostgreSQL requiere aprobación previa (ver CLAUDE.md, "Código").
//
// Reglas que este esquema hace cumplir:
//   - Todo dato de negocio cuelga de un Tenant (oficina). Nadie ve otra oficina.
//   - Un Event es la boda; una InvitationVersion es esa boda en un idioma.
//   - Los versículos NO viven aquí: siguen en data/verses.json, verificados por
//     una persona y versionados en git, para que nadie pueda alterarlos desde
//     un panel.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: la URL de conexión vive en prisma7.config.ts (migraciones) y en el
// adaptador que recibe PrismaClient (src/lib/db.ts), nunca en el esquema.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enumeraciones

enum Locale {
  ar
  es
  pt
  en
}

enum Direction {
  rtl
  ltr
}

enum NumeralSystem {
  arabic
  latin
}

enum EventType {
  wedding
  graduation
  birthday
  baptism
  memorial
}

enum HostRole {
  parents
  father
  mother
  family
  couple
  self
  institution
  host
}

/// SUPERADMIN es global; el resto siempre dentro de una oficina.
enum Role {
  SUPERADMIN
  TENANT_ADMIN
  OPERATOR
  ORGANIZER
}

enum TenantStatus {
  active
  suspended
  trial
}

/// Cómo llegó el evento: se factura distinto en cada caso.
enum AcquisitionChannel {
  self_service
  licensed_office
  concierge
}

enum EventStatus {
  draft
  published
  archived
}

/// Qué parte de la celebración es un acto.
///
/// Una boda libanesa no es una fecha: puede ser compromiso, fiesta familiar,
/// henna, preparación en casa, zaffe, ceremonia, cena y despedida, repartidos en
/// varios días, en sedes distintas y con gente distinta en cada uno. El tipo es
/// una ETIQUETA NORMALIZADA para ordenar y elegir icono, nunca una obligación:
/// `label` lo llama como lo llama esa familia, y `other` existe para que ninguna
/// celebración tenga que caber en esta lista. No se infiere de nada — ni del
/// idioma, ni de los nombres, ni de la lista de invitados.
enum ActType {
  engagement
  family_party
  henna
  preparation
  zaffe
  ceremony
  dinner
  reception
  farewell
  other
}

/// Quién puede ver un acto en la invitación pública.
///
/// `public` sale en `/i/<slug>` para cualquiera. `segmented` NO sale: solo lo ve
/// quien tiene enlace personal y está autorizado. Por defecto es `segmented`,
/// porque el fallo caro es enseñar de más: una henna íntima listada en una página
/// pública no se puede volver a esconder.
enum ActVisibility {
  public
  segmented
}

/// Una regla de audiencia deja pasar o cierra el paso.
///
/// `deny` gana siempre sobre `allow`. Es la única forma de decir «toda la familia
/// de la novia menos este grupo» sin tener que enumerar a mano a los demás.
enum AudienceMode {
  allow
  deny
}

enum RsvpStatus {
  attending
  declined
  tentative
}

enum RenderKind {
  png
  pdf
}

enum PlanTier {
  free
  single_event
  annual
  office
}

// ---------------------------------------------------------------- inquilinos

/// Una oficina que alquila la plataforma. El tenant raíz (isRoot) es la
/// plataforma misma: autoservicio y trabajos concierge cuelgan de él.
model Tenant {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  isRoot Boolean      @default(false)
  status TenantStatus @default(trial)

  /// Subdominio propio (agenciax) o dominio completo aportado por la oficina.
  subdomain    String  @unique
  customDomain String? @unique

  /// Su base de datos. Cada oficina tiene la SUYA y no comparte ninguna fila con
  /// otra: lo que impide que se vean no es el filtro del código, es que están en
  /// bases distintas del servidor. Nulo mientras el reparto sea `shared`.
  databaseName String? @unique

  // Marca blanca. Las plantillas base NO son configurables: son el producto.
  logoUrl       String?
  brandPrimary  String?
  brandAccent   String?
  defaultLocale Locale  @default(ar)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  events        Event[]
  orders        Order[]
  subscription  Subscription?
  auditLogs     AuditLog[]
  whatsapps     WhatsappConnection[]
  sinpeAccounts SinpeAccount[]
  sessions      Session[]
  publicSlugs   PublicSlug[]
  guestTokens   GuestToken[]

  @@index([status])
}

/// El directorio de las invitaciones públicas: qué oficina tiene este slug.
///
/// Con una base por oficina, `/i/<slug>` deja de poder resolverse mirando: la
/// fila está en una de trescientas bases y no se sabe en cuál. Esta tabla vive
/// en la base de CONTROL y es lo único que se consulta sin oficina, igual que
/// antes lo era la propia invitación. No lleva nada del evento dentro: dice en
/// qué base seguir buscando, y nada más.
model PublicSlug {
  slug     String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// Lo mismo para el enlace personal del invitado, `/g/<token>`.
///
/// El token no se adivina y resuelve a UNA fila, nunca a un listado: las mismas
/// dos razones por las que ya era una consulta sin oficina.
model GuestToken {
  token    String @id
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  phone        String?
  /// Solo para superadmin y admins de oficina. El cliente final entra con OTP.
  passwordHash String?
  isSuperadmin Boolean @default(false)
  locale       Locale  @default(ar)

  /// El país que maneja esta persona: ISO 3166-1 alfa-2.
  ///
  /// No es un adorno de perfil. Decide el prefijo con el que se normaliza una
  /// lista de invitados pegada sin prefijo, la zona horaria por defecto de un
  /// evento nuevo y qué medio de cobro tiene sentido ofrecer. Nulo significa
  /// «el del sistema».
  country String?

  /// Su foto, si la trajo de fuera como dirección.
  ///
  /// Se conserva porque hay perfiles que ya la tienen puesta así, pero el
  /// formulario ya no la pide: pedirle una URL de imagen a una persona normal
  /// es pedirle algo que no tiene. Lo que se usa hoy es `avatarData`.
  avatarUrl String?

  /// Su foto SUBIDA, ya recortada y reducida por el servidor.
  ///
  /// Los bytes van a PostgreSQL y no al disco por la misma razón que la tabla
  /// `Render`: un despliegue copia el código, así que un archivo dejado en el
  /// disco de la máquina desaparece con la siguiente versión. Y lo que se
  /// guarda NO es lo que se subió: se descodifica, se recorta a un cuadrado
  /// pequeño y se vuelve a codificar, de modo que los metadatos del teléfono
  /// —entre ellos las coordenadas de la casa donde se hizo la foto— no llegan
  /// nunca a la base.
  avatarData    Bytes?
  avatarType    String?
  /// La huella de la foto de hoy. Va en la dirección (`?v=`) para que el
  /// navegador pueda quedársela para siempre y aun así ver el cambio.
  avatarVersion String?

  /// Su zona horaria. Nula significa «la del país que maneja».
  ///
  /// El país da una por defecto, pero no siempre acierta: quien maneja Costa
  /// Rica desde Beirut quiere leer las horas en la suya.
  timezone    String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  memberships Membership[]
  ownedEvents Event[]      @relation("EventOwner")
  auditLogs   AuditLog[]
  sessions    Session[]
}

/// Un usuario puede pertenecer a más de una oficina con roles distintos.
model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
}

// ---------------------------------------------------------------- eventos

model Event {
  id       String  @id @default(cuid())
  tenantId String
  /// El organizador. Nulo en un trabajo concierge sin cuenta de cliente.
  ownerId  String?

  type    EventType
  status  EventStatus        @default(draft)
  channel AcquisitionChannel

  /// Fecha y hora locales del lugar, guardadas como texto para que no las
  /// desplace ninguna conversión de zona horaria. La zona se guarda aparte.
  date      String
  time      String
  timezone  String  @default("Asia/Beirut")
  hijriDate String?

  venueName    String
  venueAddress String
  venueMapUrl  String
  /// Opcionales: se piden pero pocos organizadores las conocen, y guardar 0,0
  /// sería mentir sobre dónde es la boda.
  venueLat     Float?
  venueLng     Float?

  rsvpEnabled  Boolean   @default(true)
  rsvpDeadline DateTime?

  /// Cuántos días antes se le recuerda a quien no ha contestado. Nulo = nunca.
  ///
  /// Es lo que decide si una boda sabe cuánta gente va. Un invitado que abrió
  /// el enlace y no contestó no es un «no»: es alguien que iba a hacerlo luego
  /// y se le olvidó. Perseguir eso a mano en una lista de doscientos no lo
  /// hace nadie, y por eso hasta ahora no se hacía.
  reminderDaysBefore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner    User?               @relation("EventOwner", fields: [ownerId], references: [id])
  versions InvitationVersion[]
  hosts    EventHost[]
  honorees EventHonoree[]
  guests   Guest[]
  tables   Table[]
  messages WhatsappMessage[]
  acts     EventAct[]
  segments AudienceSegment[]

  /// Para que otras tablas puedan apuntar a (id, tenantId) a la vez y la BASE
  /// impida que una fila de una oficina cuelgue del evento de otra.
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, date])
  // El repaso de recordatorios recorre solo los eventos que tienen uno puesto.
  @@index([reminderDaysBefore])
}

model EventHost {
  id      String   @id @default(cuid())
  eventId String
  role    HostRole
  /// Nombre propio: se escribe igual en todos los idiomas salvo transliteración.
  name    String
  /// Transliteraciones por idioma, cuando el nombre se escribe en otro alfabeto.
  names   Json?
  order   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventHonoree {
  id      String @id @default(cuid())
  eventId String
  name    String
  names   Json?
  order   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// Un evento compuesto en un idioma. Una boda tiene su versión en árabe y su
/// versión en inglés, con la misma lista de invitados y las mismas respuestas.
model InvitationVersion {
  id      String @id @default(cuid())
  eventId String

  /// URL pública. Global y no adivinable: es la única ruta sin tenant.
  slug String @unique

  locale        Locale
  direction     Direction
  numeralSystem NumeralSystem @default(latin)
  templateId    String        @default("classic-gold")

  /// Texto libre del anfitrión, ya escrito en este idioma.
  message String

  /// Id dentro de data/verses.json. El texto NO se guarda aquí: se resuelve
  /// contra la lista fija verificada, y si el id no existe no se muestra nada.
  quoteId String?

  themePrimary    String @default("#6B4E16")
  themeAccent     String @default("#C9A227")
  themeBackground String @default("#FBF6EC")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  renders Render[]

  @@unique([eventId, locale])
  @@index([eventId])
}

/// PNG o PDF ya generado y archivado. Regenerar con Chromium en cada visita
/// sería caro y lento.
model Render {
  id          String     @id @default(cuid())
  versionId   String
  kind        RenderKind
  /// Dónde vive el archivo cuando está en almacenamiento de objetos. Vacío
  /// mientras los bytes se guardan aquí mismo.
  url         String?
  /// El archivo. Guardarlo en la base de datos es lo que funciona en cualquier
  /// despliegue sin configurar nada; cuando haya almacenamiento de objetos, el
  /// puerto `RenderStore` se cambia por otro y esto queda a null.
  data        Bytes?
  width       Int
  height      Int
  bytes       Int
  /// Huella del contenido que produjo este archivo: si cambia, se regenera.
  contentHash String
  createdAt   DateTime   @default(now())

  version InvitationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, kind, contentHash])
  @@index([versionId])
}

// ---------------------------------------------------------------- invitados

/// El invitado no tiene cuenta. Se identifica con un token en su enlace.
model Guest {
  id      String @id @default(cuid())
  eventId String

  name   String
  phone  String?
  email  String?
  /// Idioma en el que recibe la invitación: a la abuela en árabe, a la prima
  /// de Londres en inglés, del mismo evento.
  locale Locale

  /// Token del enlace personal. No adivinable y revocable.
  token      String    @unique
  maxParty   Int       @default(1)
  invitedAt  DateTime?
  openedAt   DateTime?
  /// Cuándo se le encoló el recordatorio. Se escribe UNA vez: recordar dos
  /// veces lo mismo deja de ser un recordatorio y pasa a ser spam.
  remindedAt DateTime?

  /// Quién creó la ficha. El formulario público es abierto por necesidad —la
  /// invitación se reenvía por WhatsApp— así que la IP es lo único que permite
  /// frenar a quien lo inunde.
  createdIp String?
  /// Verdadero cuando el propio invitado se dio de alta al confirmar.
  selfAdded Boolean @default(false)

  /// En qué mesa se sienta. Nulo mientras no se le haya asignado una.
  tableId String?

  createdAt DateTime @default(now())

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Clave foránea COMPUESTA, con el evento dentro: así la base impide sentar
  /// a un invitado en la mesa de OTRA boda. Con `tableId` a secas dependería de
  /// que el código no se equivoque nunca, y una consulta a mano no depende de
  /// eso.
  ///
  /// `NoAction` al borrar: `SetNull` sobre una clave compuesta pondría a nulo
  /// también `eventId`, que no lo admite. Quitar una mesa levanta primero a
  /// quien esté en ella —en la misma transacción, ver `lib/tables/service.ts`—
  /// y esta clave es la red que avisa si alguien se lo salta.
  table    Table?            @relation(fields: [tableId, eventId], references: [id, eventId], onDelete: NoAction)
  rsvp     Rsvp?
  messages WhatsappMessage[]

  segments   GuestSegment[]
  actInvites GuestActInvite[]
  actRsvps   GuestActRsvp[]

  /// Misma razón que en `Event`: permite apuntar a (id, eventId) a la vez.
  /// El invitado no lleva `tenantId` —cuelga de su evento— así que la cadena se
  /// cierra por ahí: mensaje → evento (con oficina) → invitado (con evento).
  @@unique([id, eventId])
  @@index([eventId])
  @@index([eventId, locale])
  @@index([tableId])
}

/// Una mesa del salón.
///
/// Cuelga del evento, como los invitados: la oficina se resuelve por el evento
/// antes de tocar nada, que es como funciona todo lo demás de esta boda.
// ------------------------------------------------------------------ los actos

/// Un acto: una parte de la celebración, con su hora, su sitio y su gente.
///
/// `Event` deja de ser «una tarjeta con una fecha» y pasa a ser el CONTENEDOR.
/// Lo que tiene hora y sede es el acto, no la boda: una henna el jueves en casa,
/// la ceremonia el sábado en la iglesia y la recepción esa noche en un salón son
/// tres actos del mismo evento, con tres listas distintas de invitados.
///
/// El evento conserva sus columnas de fecha y sede, y NO son un duplicado: son
/// lo que leen las pantallas que todavía no saben de actos, y lo que se copió al
/// acto principal en la migración. Mientras existan, la verdad de «cuándo y
/// dónde» es el acto.
model EventAct {
  id      String @id @default(cuid())
  eventId String

  type  ActType @default(other)
  /// Cómo lo llama ESTA familia. Vacío usa el nombre del tipo.
  label String?
  /// En qué orden se cuenta la agenda. No es único: reordenar con un índice
  /// único obliga a pasar por valores temporales para no chocar consigo mismo.
  order Int     @default(0)

  /// Igual que en `Event`: hora local del lugar, como texto, y la zona aparte.
  /// Un acto puede estar en otra zona que el resto — una boda de Beirut con la
  /// fiesta previa en Costa Rica no es raro en este mercado.
  date     String
  time     String
  endTime  String?
  timezone String

  venueName    String
  venueAddress String
  venueMapUrl  String
  venueLat     Float?
  venueLng     Float?

  /// Aforo. Es un AVISO para quien monta el salón, no una barrera: la misma
  /// regla que el tope de plazas de una mesa.
  capacity Int?
  /// Un acto opcional se ofrece; uno no opcional se da por hecho para quien
  /// está invitado.
  optional Boolean @default(false)

  rsvpEnabled  Boolean       @default(true)
  rsvpDeadline DateTime?
  visibility   ActVisibility @default(segmented)

  /// El acto que heredó lo que el evento traía antes de que existieran los
  /// actos. Uno por evento, y lo impide un índice parcial en la migración:
  /// dos principales serían dos respuestas «globales» distintas.
  isMain Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  translations ActTranslation[]
  audiences    ActAudience[]
  invites      GuestActInvite[]
  rsvps        GuestActRsvp[]

  /// Para que las tablas de abajo apunten a (id, eventId) a la vez: la BASE
  /// impide que un invitado de una boda responda al acto de otra.
  @@unique([id, eventId])
  @@index([eventId, order])
}

/// El acto escrito en cada idioma. Traducir NO concede permisos.
model ActTranslation {
  id     String @id @default(cuid())
  actId  String
  locale Locale

  label        String
  description  String?
  /// La sede escrita en ese idioma. Nula usa la del acto.
  venueName    String?
  venueAddress String?

  act EventAct @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@unique([actId, locale])
}

/// Un grupo de invitados con nombre: «familia de la novia», «trabajo», «VIP».
///
/// Es lo que hace que asignar cuatrocientas personas a cinco actos no sea
/// cuatrocientas decisiones: se asigna el grupo al acto, y las excepciones se
/// escriben una a una con `GuestActInvite`.
model AudienceSegment {
  id      String @id @default(cuid())
  eventId String

  /// Estable y en minúsculas, para poder importarlo desde un CSV.
  key  String
  name String

  createdAt DateTime @default(now())

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members  GuestSegment[]
  actRules ActAudience[]

  @@unique([eventId, key])
  @@unique([id, eventId])
}

/// A qué grupos pertenece un invitado. Puede pertenecer a varios.
model GuestSegment {
  id        String @id @default(cuid())
  guestId   String
  segmentId String
  /// Repetido a propósito: es lo que ata las dos claves foráneas al MISMO
  /// evento. Sin él, la base admitiría meter al invitado de una boda en el
  /// grupo de otra y solo lo impediría el cuidado de quien escribe la consulta.
  eventId   String

  createdAt DateTime @default(now())

  guest   Guest           @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)
  segment AudienceSegment @relation(fields: [segmentId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([guestId, segmentId])
  @@index([segmentId])
}

/// Qué grupos entran a un acto, y cuáles no.
model ActAudience {
  id        String @id @default(cuid())
  actId     String
  segmentId String
  eventId   String

  mode AudienceMode @default(allow)

  act     EventAct        @relation(fields: [actId, eventId], references: [id, eventId], onDelete: Cascade)
  segment AudienceSegment @relation(fields: [segmentId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([actId, segmentId])
  @@index([actId])
}

/// La excepción con nombre y apellido: este invitado a este acto.
///
/// Los grupos cubren el caso normal; esto cubre el que no se puede escribir con
/// un grupo sin inventarse un grupo de una persona. Vale en los dos sentidos
/// (`excluded`), y manda sobre los grupos.
model GuestActInvite {
  id      String @id @default(cuid())
  guestId String
  actId   String
  eventId String

  /// Cuántos puede traer A ESTE ACTO. Nulo usa el del invitado: quien trae
  /// acompañante a la recepción no lo trae por eso a la henna.
  maxParty Int?
  excluded Boolean @default(false)

  createdAt DateTime @default(now())

  guest Guest    @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)
  act   EventAct @relation(fields: [actId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([guestId, actId])
  @@index([actId])
}

/// La respuesta, POR ACTO. Es la fuente de verdad.
///
/// `Rsvp` sigue existiendo y se mantiene al día como RESUMEN —«viene a la boda»—
/// porque lo leen las mesas, la exportación y las pantallas de hoy. Pero un
/// resumen no puede decir «a la ceremonia sí y a la recepción no», y eso es
/// justo lo que una familia necesita saber para contar sillas.
model GuestActRsvp {
  id      String @id @default(cuid())
  guestId String
  actId   String
  eventId String

  status  RsvpStatus
  /// Incluyéndose. Se comprueba contra el tope de ESTE acto.
  party   Int        @default(1)
  message String?

  respondedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guest Guest    @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: Cascade)
  act   EventAct @relation(fields: [actId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([guestId, actId])
  @@index([actId, status])
}

model Table {
  id      String @id @default(cuid())
  eventId String

  /// Como la llama el salón: «Mesa 1», «Familia del novio», «Novios».
  name     String
  /// Cuántas personas caben. Es un aviso, no una barrera: quien monta el salón
  /// sabe cuándo puede meter una silla más, y el programa no.
  seats    Int    @default(10)
  /// El orden en que se enseña y se imprime. Ordenar por nombre pondría la
  /// «Mesa 10» delante de la «Mesa 2».
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests Guest[]

  @@unique([id, eventId])
  /// Dos «Mesa 1» en la misma boda es un error de dedo, y confunde a quien
  /// reparte a doscientas personas.
  @@unique([eventId, name])
  @@index([eventId, position])
}

model Rsvp {
  id      String     @id @default(cuid())
  guestId String     @unique
  status  RsvpStatus
  /// Número de asistentes incluyendo al invitado.
  party   Int        @default(1)
  message String?

  respondedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- facturación

model Plan {
  id            String   @id @default(cuid())
  tier          PlanTier @unique
  name          String
  /// En la moneda menor (céntimos), para no perder precisión.
  priceMonthly  Int
  pricePerEvent Int      @default(0)
  maxEvents     Int?
  maxGuests     Int?
  whiteLabel    Boolean  @default(false)

  subscriptions Subscription[]
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  planId   String

  startedAt   DateTime  @default(now())
  renewsAt    DateTime?
  cancelledAt DateTime?

  /// Comisión por invitación publicada, en puntos básicos (250 = 2,5 %).
  revenueShareBps Int @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
}

// ---------------------------------------------------------------- trazabilidad

/// Quién tocó qué. Sin esto, el acceso de soporte del superadmin a un evento
/// ajeno es una puerta trasera.
/// El logo y el icono de la pestaña, SUBIDOS.
///
/// Los bytes van a PostgreSQL y no al disco por la misma razón que `Render` y
/// que la foto de perfil: un despliegue copia el código y se lleva por delante
/// cualquier archivo que se hubiera dejado al lado.
///
/// Una fila por clase —`logo` e `icon`— porque la marca es de la PLATAFORMA,
/// no de cada oficina: es el nombre y el logo de quien monta el sistema.
model BrandAsset {
  /// `logo` o `icon`.
  kind String @id

  data    Bytes
  type    String
  /// La huella de la imagen de hoy. Va en la dirección (`?v=`) para que el
  /// navegador pueda quedársela para siempre y aun así ver el cambio.
  version String

  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  actorId  String?

  action   String
  entity   String
  entityId String
  metadata Json?
  ip       String?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------- cobro

enum Currency {
  USD
  LBP
  CRC
}

/// Líbano cobra por Whish. `manual` cubre transferencia y efectivo, que es como
/// se cobra un trabajo concierge antes de que exista pasarela.
enum PaymentProviderId {
  whish
  tilopay
  /// Costa Rica, por SINPE Móvil. No es una pasarela: no hay a quién
  /// preguntarle. Lo confirma un correo del banco leído por IMAP, y el
  /// comprobante de ese correo es el `providerRef`.
  sinpe
  /// Sin pasarela: el efectivo, que marca una persona con su nombre.
  manual
  /// Solo desarrollo. Se guardaba como `manual`, y esa mentira tenía coste: un
  /// cobro de prueba quedaba indistinguible de uno en efectivo, y al resolverlo
  /// por el proveedor GUARDADO se habría tratado como dinero ya cobrado en mano.
  mock
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  refunded
}

/// En qué punto está un movimiento leído del banco.
enum SinpeMovementStatus {
  /// Leído y guardado, sin cobro al que aplicarlo. Que sobren es NORMAL: alguien
  /// paga sin poner el código, o paga otra cosa. Lo asigna una persona.
  pending
  /// Aplicado a un cobro. El `Payment` lleva el comprobante como `providerRef`.
  applied
  /// No es dinero que entra, o es el mismo dinero contado dos veces. Se guarda
  /// igual: saber POR QUÉ no se cobró algo vale tanto como cobrarlo.
  ignored
}

/// Un buzón de banco que se revisa para cobrar por SINPE Móvil.
///
/// El SINPE no tiene pasarela: no hay a quién preguntarle si un pago entró. Lo
/// único que llega es un correo del banco, así que esto guarda de qué buzón hay
/// que leerlo.
model SinpeAccount {
  id String @id @default(cuid())

  /// NULO es la cuenta de la PLATAFORMA: el buzón donde las oficinas pagan su
  /// mensualidad. Con oficina, es el buzón de ESA oficina, donde sus clientes le
  /// pagan a ella. Hoy solo se usa lo primero, pero el modelo lo distingue desde
  /// el principio: cambiarlo después significaría migrar filas de dinero.
  tenantId String?

  name  String
  bank  String
  /// El número al que se le hace el SINPE, en E.164 como todos los demás.
  phone String

  imapHost          String
  imapPort          Int     @default(993)
  imapUser          String
  /// Cifrada con AES-256-GCM y la llave fuera de la base, como la del SMTP.
  /// Quien tiene este buzón ve todo el correo de quien cobra.
  imapPasswordEnc   String
  folder            String  @default("INBOX")
  /// Comprobar el certificado del servidor. Se apaga SOLO con un certificado
  /// propio que no valide; apagarlo deja que alguien en medio lea la contraseña
  /// y todo el correo, así que viene encendido.
  verifyCertificate Boolean @default(true)

  active           Boolean @default(true)
  /// Verdadero cuando este buzón cobra las MENSUALIDADES de la plataforma.
  forSubscriptions Boolean @default(false)

  lastCheckedAt DateTime?
  /// Lo último que falló al conectar. Sale en el panel a propósito: un buzón que
  /// dejó de conectar es plata que deja de entrar sin que nadie se entere.
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements SinpeMovement[]

  @@index([active])
  @@index([tenantId])
}

/// Un movimiento leído de un correo del banco.
model SinpeMovement {
  id        String  @id @default(cuid())
  /// La oficina a la que pertenece, copiada de la cuenta. Nulo = la plataforma.
  tenantId  String?
  accountId String

  senderName  String?
  senderPhone String?
  /// Céntimos enteros, como `Payment.amount`. Ningún decimal toca dinero.
  amount      Int
  currency    Currency @default(CRC)

  /// El comprobante del banco. ÚNICO por cuenta: leer el mismo correo dos veces
  /// no puede crear dos movimientos, y eso no lo garantiza el código sino la
  /// base. Es además el `providerRef` del `Payment` que se cree.
  reference String
  /// Lo que escribió quien pagó. Es lo ÚNICO que dice a qué cobro va.
  detail    String?

  bank              String?
  movementType      String
  destinationNumber String?

  status    SinpeMovementStatus @default(pending)
  /// El cobro al que se aplicó. Uno por movimiento y movimiento por cobro.
  paymentId String?             @unique

  receivedAt DateTime  @default(now())
  settledAt  DateTime?
  /// El correo tal cual llegó. Cuando se discute un cobro, es lo único que sirve.
  raw        String

  account SinpeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, reference])
  @@index([tenantId, status])
  @@index([status, receivedAt])
}

/// En qué punto está una conexión de WhatsApp.
enum WhatsappStatus {
  /// Creada, todavía sin abrir sesión.
  pending
  /// Esperando a que alguien escanee el código.
  qr
  connected
  /// Se cayó o cerraron la sesión desde el teléfono.
  disconnected
}

/// Un número de WhatsApp de una oficina.
///
/// MULTI-NÚMERO Y MULTI-OFICINA desde el primer día: una oficina con dos
/// mostradores tiene dos números, y dos oficinas jamás comparten uno. Todo
/// cuelga de `tenantId` como el resto del negocio.
model WhatsappConnection {
  id       String @id @default(cuid())
  tenantId String

  /// Cómo lo llama la oficina: «Mostrador Hamra», «Ventas».
  name  String
  /// El número, en E.164, tal como lo dice WhatsApp al conectar. Antes, nulo.
  phone String?

  status WhatsappStatus @default(pending)
  /// El código que hay que escanear AHORA. Caduca en segundos y se borra al
  /// conectar: no es un secreto duradero, pero tampoco se deja tirado.
  qrCode String?        @db.Text

  /// Las credenciales de la sesión, CIFRADAS con la llave de fuera de la base.
  /// Sin cifrar, un volcado de la base dejaría escribir desde el WhatsApp del
  /// cliente: es el secreto más peligroso que guarda este proyecto.
  authEnc String? @db.Text

  /// El que se usa cuando nadie elige.
  isDefault Boolean @default(false)

  /// Freno. Automatizar un número personal va contra los términos de WhatsApp
  /// y es como se pierde el número del cliente; esto no lo hace legal, lo hace
  /// sobrevivible. `sentDay` es la fecha local del contador, en texto.
  dailyCap  Int     @default(200)
  sentToday Int     @default(0)
  sentDay   String?

  lastSeenAt DateTime?
  /// Lo último que falló, para que la pantalla diga por qué y no solo que no.
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsappMessage[]

  @@unique([tenantId, name])
  // Para que un mensaje pueda apuntar a (id, tenantId) A LA VEZ: es lo que
  // hace IMPOSIBLE —no improbable— que una fila de la oficina A cuelgue de un
  // número de la B.
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

/// Un mensaje en cola.
///
/// La cola existe por el freno: mandar doscientas invitaciones de golpe es
/// exactamente lo que hace que WhatsApp cierre el número. Se encolan, y un
/// proceso aparte las va soltando con su retardo.
model WhatsappMessage {
  id       String @id @default(cuid())
  tenantId String

  /// Por qué número salió. Nulo cuando ese número ya no está conectado.
  ///
  /// Se queda a nulo, NO se borra la fila, y es la misma regla que ya valía para
  /// el evento y el invitado: el mensaje es el REGISTRO de lo que se mandó.
  /// Quitar un número era lo único que se llevaba ese registro por delante, y
  /// quitar un número es lo NORMAL — a un número lo cierran y la oficina conecta
  /// otro. Con la cascada, esa oficina perdía el histórico entero de a quién le
  /// había escrito, que es justo lo que se mira cuando alguien pregunta si a
  /// Rami le llegó su invitación.
  connectionId String?

  /// A quién, en E.164. Se guarda aunque el invitado se borre después: es el
  /// registro de lo que se mandó.
  toPhone String
  body    String @db.Text

  /// El invitado, cuando lo hay. Nulo en un mensaje suelto.
  guestId String?
  eventId String?

  /// Qué es este mensaje: `invitation` o `reminder`.
  ///
  /// Los distingue porque un invitado recibe LOS DOS, y el índice que impide
  /// encolarlo dos veces tiene que dejar pasar el segundo. Sin esto, el mismo
  /// índice que evita el doble envío habría impedido el recordatorio.
  kind String @default("invitation")

  /// `queued` · `processing` · `sent` · `sent_unknown` · `failed` · `canceled`
  ///
  /// `processing` y `sent_unknown` no estaban, y su ausencia era el fallo. Sin
  /// `processing`, dos repartidores leían la MISMA fila antes de que ninguno la
  /// marcara, y el invitado recibía dos mensajes. Y sin `sent_unknown` no había
  /// forma de decir la verdad cuando WhatsApp acepta el mensaje y el proceso se
  /// muere antes de anotarlo: reenviar es duplicar y no reenviar es perderlo,
  /// así que lo que corresponde es DECIRLO y que una persona decida.
  status String  @default("queued")
  error  String?
  /// Cuántas veces se intentó. A la tercera se deja quieto.
  tries  Int     @default(0)

  /// Quién lo tiene cogido y hasta cuándo. Un repartidor que se muere deja el
  /// arriendo vencido, y eso es lo que permite recuperar la fila sin adivinar.
  claimedBy  String?
  leaseUntil DateTime?

  /// Lo que WhatsApp devolvió, cuando devuelve algo. Es el único asa para
  /// averiguar después si un mensaje dudoso llegó de verdad.
  providerMessageId String?

  /// Antes de esta hora no sale. Nulo significa «en cuanto le toque».
  ///
  /// Una boda se anuncia el día que la pareja decide, no el día que la oficina
  /// se sienta a preparar la lista. Sin esto había que acordarse de volver a
  /// entrar esa mañana y pulsar el botón — y quien se acuerda de eso a las ocho
  /// de la mañana de un sábado no existe.
  ///
  /// Se guarda en UTC, como todo aquí. Quien la escribe lo hace en su reloj, y
  /// la conversión ocurre en el servidor con la zona de esa persona.
  scheduledAt DateTime?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  /// La conexión, por (id, tenantId) y no solo por id.
  ///
  /// Esa es la diferencia entre «el código siempre pone el tenant correcto» y
  /// «la base no admite otra cosa». `tenantId`, `eventId` y `guestId` no tenían
  /// ninguna clave foránea: una consulta escrita a mano, o un descuido futuro,
  /// podía dejar un mensaje de una oficina colgando del número de otra.
  /// `NoAction` por lo mismo que el evento y el invitado: sobre una clave
  /// compuesta, `SET NULL` pondría a nulo TODAS sus columnas —`tenantId`
  /// incluido, que no lo admite—. Se desata a mano al quitar el número, en la
  /// misma transacción (`lib/whatsapp/connections.ts`).
  connection WhatsappConnection? @relation(fields: [connectionId, tenantId], references: [id, tenantId], onDelete: NoAction)

  /// A `null` cuando se borra: el mensaje es el REGISTRO de lo que se mandó, y
  /// borrarlo porque el evento ya pasó sería borrar la prueba.
  /// Claves COMPUESTAS también aquí, no solo en la conexión.
  ///
  /// Con `eventId` a secas, que el evento fuera de la misma oficina que el
  /// mensaje dependía de que el código no se equivocara nunca. Ahora no lo
  /// admite la base: el evento tiene que ser de ESTA oficina, y el invitado
  /// tiene que ser de ESE evento — el invitado no lleva oficina porque cuelga
  /// de su evento, así que la cadena se cierra por ahí.
  ///
  /// `NoAction` y no `SetNull`: sobre una clave compuesta, `SET NULL` pondría a
  /// nulo TODAS sus columnas, y `tenantId` no lo admite.
  ///
  /// En la MIGRACIÓN van además como `DEFERRABLE INITIALLY DEFERRED`, y sin eso
  /// no funcionan: borrar una oficina fallaba, porque la cascada borra sus
  /// eventos y la comprobación saltaba ahí mismo aunque los mensajes que
  /// apuntaban a ese evento se estuvieran borrando en la misma orden. Prisma no
  /// sabe declarar `DEFERRABLE`, así que eso vive solo en el SQL — como el
  /// índice único parcial de los cobros.
  ///
  /// El día que se añada «borrar un evento» a mano habrá que desligar antes
  /// estos mensajes, igual que hace `removeTable` con las mesas.
  event Event? @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: NoAction)
  guest Guest? @relation(fields: [guestId, eventId], references: [id, eventId], onDelete: NoAction)

  // Por `connectionId` primero: es por donde filtra el repartidor. El índice
  // anterior empezaba por `status` y no le servía para nada.
  @@index([connectionId, status, scheduledAt, createdAt])
  @@index([status, leaseUntil])
  @@index([tenantId, eventId])
}

/// Configuración del sistema, editable desde el panel.
///
/// Vive aquí y no en el `.env` porque quien administra la plataforma tiene que
/// poder cambiarla sin entrar al servidor. Lo que NO cambia es la regla de los
/// secretos: una contraseña se guarda en `valueEnc`, cifrada con la llave de
/// `CITAS_SECRET_KEY_FILE`, que sigue fuera de la base. Un volcado de la base no
/// revela ni el SMTP ni el cobro.
model Setting {
  key String @id

  /// Lo que no es secreto: un host, un puerto, una URL.
  value String?

  /// Lo que sí lo es, cifrado (`v1.…`). Nunca se devuelve a una pantalla: se
  /// puede reemplazar, no leer.
  valueEnc String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Order {
  id       String  @id @default(cuid())
  tenantId String
  eventId  String?

  /// Importe en la unidad menor de la moneda: céntimos en USD, unidades en LBP.
  /// Nunca un decimal.
  amount      Int
  currency    Currency
  description String
  status      PaymentStatus @default(pending)

  /// Cuántas invitaciones desbloquea este pedido en su evento. Nulo cuando no
  /// es un paquete: el pago de una mensualidad no abre invitaciones.
  packageGuests Int?

  /// La pareja que se casa. NO tiene cuenta aquí, así que su enlace de pago es
  /// público y viaja por WhatsApp igual que las invitaciones.
  clientName  String?
  clientPhone String?

  /// Token del enlace público de pago. Corto y no adivinable, como /g/<token>.
  payToken String? @unique

  /// El código que quien paga escribe en el detalle del SINPE.
  ///
  /// Sin él, un SINPE no se puede casar con nada. El comprobante del banco no
  /// sirve: lo inventa el banco al mandar el dinero, así que aquí no se conoce
  /// antes. Y el monto solo tampoco —dos oficinas con el mismo plan pagan lo
  /// mismo el mismo día—, que es justo lo que no se puede confundir cuando el
  /// resultado es activarle el plan a la oficina equivocada.
  ///
  /// Corto y en mayúsculas porque se teclea a mano en el móvil, y sin letras
  /// que se confundan (ni O ni I ni 0 ni 1).
  payCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId, status])
  @@index([eventId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String

  provider    PaymentProviderId
  /// Identificador del cobro en el proveedor. Único junto al proveedor: es lo
  /// que impide procesar dos veces la misma notificación.
  providerRef String
  status      PaymentStatus     @default(pending)

  amount   Int
  currency Currency

  /// La página del proveedor a la que se manda al pagador.
  ///
  /// Se guarda para poder REUTILIZARLA. Sin esto, un doble clic en «Pagar»
  /// abría dos cobranzas en Whish para el mismo pedido: dos referencias, dos
  /// filas, y la posibilidad real de que alguien pague dos veces su boda.
  payUrl String?

  /// Última vez que se le preguntó al proveedor cuál es la verdad.
  lastCheckedAt DateTime?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  // Además, en la migración: un índice único PARCIAL sobre (orderId, provider)
  // limitado a `status = 'pending'`. Prisma no sabe declarar índices parciales,
  // así que vive solo en el SQL — y ahí es donde tiene que estar, porque es la
  // base la que impide que existan dos cobros abiertos para el mismo pedido
  // aunque dos peticiones lleguen a la vez.

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, lastCheckedAt])
}

/// Todo lo que llega del proveedor se guarda crudo. Cuando un cobro se discute
/// —y se discute— esto es lo único que sirve.
model PaymentEvent {
  id        String @id @default(cuid())
  paymentId String

  /// callback | poll | manual
  kind    String
  payload Json

  receivedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, receivedAt])
}

// ---------------------------------------------------------------- acceso

/// Código de un solo uso enviado por correo. El cliente final no tiene
/// contraseña: no hay contraseña que perder ni que reutilizar.
model LoginCode {
  id       String  @id @default(cuid())
  email    String
  tenantId String?

  /// Nunca se guarda el código en claro.
  codeHash   String
  expiresAt  DateTime
  /// Marcado en cuanto se usa: un código vale exactamente una vez.
  consumedAt DateTime?
  /// Intentos fallidos. Pasado el límite el código queda muerto.
  attempts   Int       @default(0)

  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// Sesión activa. En la cookie viaja el token; aquí solo vive su hash, de forma
/// que un volcado de la base de datos no permite suplantar a nadie.
model Session {
  id       String  @id @default(cuid())
  userId   String
  /// Oficina en la que se está trabajando. Nulo para el superadmin fuera de una.
  tenantId String?

  tokenHash String   @unique
  expiresAt DateTime

  userAgent String?
  ip        String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// La oficina, para poder mirar si sigue abierta al resolver la sesión.
  ///
  /// Sin esta relación, suspender una oficina no suspendía nada: las sesiones
  /// abiertas duran treinta días y seguían trabajando hasta que a alguien se le
  /// ocurriera cerrar sesión. Borrar la oficina se lleva sus sesiones.
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}
